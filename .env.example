# =============================================================================
# Pata Limpa CRM — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA compartilhe o arquivo .env ou faça commit dele no repositório.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados PostgreSQL
# Formato: postgres://usuario:senha@host:porta/nome_do_banco
# Exemplo Hostinger: postgres://patalimpa:senha123@localhost:5432/patalimpa_db
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://usuario:senha@localhost:5432/patalimpa_db

# -----------------------------------------------------------------------------
# Ambiente de execução
# Em produção DEVE ser "production" para ativar HTTPS nos cookies e
# o servidor de arquivos estáticos do Express.
# -----------------------------------------------------------------------------
NODE_ENV=production

# -----------------------------------------------------------------------------
# Porta do servidor HTTP
# Na Hostinger, o padrão para Node.js é 3000 (ou a porta que o painel indica).
# Se estiver usando Nginx como reverse proxy, use qualquer porta livre.
# -----------------------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------------------
# Credenciais do administrador do sistema
# Criadas automaticamente no primeiro boot se o usuário ainda não existir.
# Use um e-mail real e uma senha forte (mínimo 12 caracteres).
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte

# -----------------------------------------------------------------------------
# Chave secreta para assinatura de cookies de sessão
# Gere uma string aleatória segura com: openssl rand -base64 32
# Obrigatória em produção. Troque a cada deploy se suspeitar de comprometimento.
# -----------------------------------------------------------------------------
SESSION_SECRET=troque-por-string-aleatoria-longa-gerada-com-openssl

# -----------------------------------------------------------------------------
# Nível de log (opcional)
# Valores: trace | debug | info | warn | error | fatal
# Padrão: info
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Número de WhatsApp do suporte/admin (opcional)
# Exibido como fallback quando nenhum número de contato está cadastrado.
# Formato internacional sem espaços: 5511999999999
# -----------------------------------------------------------------------------
VITE_ADMIN_WHATSAPP=5511999999999
